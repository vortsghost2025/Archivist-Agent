{
  "$schema": "https://app.kilo.ai/config.json",
  "compaction": {
    "auto": false,
    "prune": true,
    "tail_turns": 5,
    "preserve_recent_tokens": 30000,
    "reserved": 8000
  },
  "agent": {
    "orchestrator": {
      "steps": 50
    },
    "plan": {
      "model": "nvidia/openai/nem-3-ultra",
      "steps": 30
    },
    "code": {
      "steps": 40
    },
    "build": {
      "steps": 35
    },
    "debug": {
      "model": "nvidia/openai/nem-3-ultra",
      "steps": 40
    },
    "ask": {
      "steps": 15
    },
    "general": {
      "steps": 40
    },
    "code-reviewer": {
      "model": "nvidia/openai/nem-3-ultra",
      "steps": 25
    }
  },
  "provider": {
    "nvidia": {
      "models": {
        "glm-5.1": {
          "name": "GLM-5.1",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "nem-3-ultra": {
          "name": "NEM-3-Ultra",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "S:\\\\self-organizing-library": "allow",
      "S:\\\\Archivist-Agent": "allow",
      "S:\\\\SwarmMind": "allow",
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "write": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "web": {
      "*": "allow"
    }
  }
}