{
  "$schema": "https://app.kilo.ai/config.json",
  "agent": {
    "orchestrator": {},
    "plan": {
      "model": "nvidia/openai/gpt-oss-120b"
    },
    "code": {},
    "build": {},
    "debug": {
      "model": "nvidia/openai/gpt-oss-120b"
    },
    "ask": {},
    "general": {},
    "code-reviewer": {
      "model": "nvidia/openai/gpt-oss-120b"
    }
  },
  "provider": {
    "nvidia": {
      "models": {
        "glm-5.1": {
          "name": "GLM-5.1",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "S:\\\\self-organizing-library": "allow",
      "S:\\\\Archivist-Agent": "allow",
      "S:\\\\SwarmMind": "allow",
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "write": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "web": {
      "*": "allow"
    }
  }
}
