{
  "$schema": "https://app.kilo.ai/config.json",
  "compaction": {
    "auto": false,
    "prune": true,
    "tail_turns": 5,
    "preserve_recent_tokens": 30000,
    "reserved": 8000
  },
  "agent": {
    "orchestrator": {
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "task": "allow",
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "lsp": "allow"
      },
      "steps": 50
    },
"plan": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "steps": 30
    },
    "code": {
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "task": "allow",
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "lsp": "allow"
      },
      "steps": 40
    },
    "build": {
      "steps": 35
    },
    "debug": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "steps": 40
    },
    "ask": {
      "steps": 15
    },
    "general": {
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "task": "allow",
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "lsp": "allow"
      },
      "steps": 40
    },
    "explore": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "mode": "all",
      "permission": {
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "task": "allow",
        "edit": "allow",
        "bash": "allow",
        "external_directory": "allow",
        "todoread": "allow",
        "todowrite": "allow",
        "skill": "allow",
        "lsp": "allow"
      },
      "steps": 30
    },
    "code-reviewer": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "steps": 25
    },
    "lane-worker": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "steps": 25
    },
    "git-worker": {
      "model": "nvidia/nemotron-3-ultra-550b-a55b",
      "steps": 20
    }
  },
  "provider": {
    "nvidia": {
      "models": {
        "glm-5.1": {
          "name": "GLM-5.1",
          "tool_call": true,
          "limit": {
            "context": 128000,
            "output": 16384
          }
        },
        "nvidia/nemotron-3-ultra-550b-a55b": {
          "name": "Nemotron-3-Ultra-550B",
          "tool_call": true,
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        },
        "minimaxai/minimax-m3": {
          "name": "Minimax M3 (Vision)",
          "tool_call": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"]
          },
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    }
  },
  "permission": {
    "external_directory": {
      "S:\\\\self-organizing-library": "allow",
      "S:\\\\Archivist-Agent": "allow",
      "S:\\\\SwarmMind": "allow",
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "write": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "web": {
      "*": "allow"
    }
  }
}
