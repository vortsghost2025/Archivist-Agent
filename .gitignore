# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
!.identity/public.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Identity keys (NEVER commit private keys)
.identity/private.pem
.identity/ed25519_private.pem
.identity/snapshot.jws
*.key

# Context buffer (working notes, not source)
/context-buffer/

# Session memory (persists locally)
.memory/

# Inbox hygiene - prevent UUID/temp heartbeat files from being committed
# Only heartbeat-{lane}.json (single file per lane) should exist
lanes/*/inbox/blocked/
lanes/*/inbox/!(*-library.json|README.md)
lanes/*/inbox/processed/
lanes/*/inbox/expired/
lanes/*/broadcast/trust-store.json
lanes/*/inbox/watcher.log
lanes/*/inbox/heartbeat-*.json
lanes/*/outbox/

lanes/*/outbox/unsigned/
logs/quarantine-tracker.json

# Pagefind generated index (rebuilt on each build)
/public/pagefind/
.vercel
nul

# Compact audit runtime artifacts
.compact-audit/
COMPACT_CONTEXT_HANDOFF.md
lanes/*/state/traces/
lanes/*/state/worker-audit.log
lanes/*/state/sovereignty-report-*.json
lanes/*/state/task-chain-state.json
lanes/*/logs/heartbeat*.log
lanes/broadcast/system_state.json

# Graph snapshot watcher state
.cache/

# WSL/Windows mount artifacts
S:/

# Runtime archive and quarantine (ephemeral)
lanes/*/inbox/archive/
lanes/*/inbox/quarantine/
lanes/broadcast/hygiene/
lanes/broadcast/operator_alert_*.json
lanes/broadcast/quarantine/

# Large graph/data snapshots
data/snapshots/

# Local library copies (duplicates of public/ assets)
library/

# Graph debug screenshots and temp logs
graph-*.png
*.tmp-graph-*.log
.tmp-graph-*.log
graph_area_*.png
nav_graph_*.png
graph_canvas.png

# Debug/dev scripts (one-off)
scripts/capture_graph.js
scripts/debug_graph.js
deliver-*.js

# Temp scratch directory
tmp/

# Scratch/analysis files at root
analyze_graph.js
analyze.js
test-library-signing.js

# Playwright CLI cache
.playwright-cli/

# Test results
test-results/

# Superpowers session state
.superpowers/

# Firebase debug log
firebase-debug.log

# Old clone readme
README-OLD-WINDOWS-CLONE.txt

# Screenshots
*.png

# Firebase debug
firebase-debug.log

# Scratch/output files at root
answer.txt
output.txt
test-write-permission.txt
verdict.json
build.log
load-context.js
nul

# Work claim registry (runtime coordination, advisory only)
lanes/*/state/work-claim.json
.work-claim.json
**/quarantine-archive-*/

# Runtime metrics/snapshots (regenerated continuously, never commit)
**/metrics/resource_usage.jsonl
**/state/snapshots/latest.json
**/cps_log.jsonl
lanes/broadcast/journal/SNAPSHOT.json
lanes/broadcast/last-recovery.json
