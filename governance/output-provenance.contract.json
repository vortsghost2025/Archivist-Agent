{
  "version": "1.1.0",
  "output_provenance_required": true,
  "required_order": [
    "OUTPUT_PROVENANCE:",
    "agent:",
    "lane:",
    "target:"
  ],
  "required_fields": {
    "agent": "required",
    "lane": "required",
    "target": "required",
    "generated_at": "recommended",
    "session_id": "recommended"
  },
  "lane_defaults": {
    "archivist": "governance-root",
    "swarmmind": "optimization-runtime",
    "library": "memory-verification",
    "kernel": "compiler-performance",
    "chatgpt": "exterior-synthesis"
  },
  "document_classifications": {
    "ROOT_GOVERNANCE_DOCS": {
      "provenance_required": false,
      "description": "Constitutional source documents at repo root level. These are authored by operators or founding processes, not generated by agents. Exempt from output contract unless regenerated by an agent.",
      "exempt_patterns": [
        "BOOTSTRAP.md",
        "COVENANT.md",
        "GOVERNANCE.md",
        "VERIFICATION_LANES.md",
        "CHECKPOINTS.md",
        "USER_DRIFT_SCORING.md",
        "CPS_ENFORCEMENT.md",
        "RECIPROCAL_ACCOUNTABILITY.md",
        "README.md",
        "AGENTS.md",
        "CLAUDE.md",
        "SPEC.md"
      ],
      "scope_note": "Exempt unless regenerated by an agent. If an agent rewrites the file, it MUST include provenance."
    },
    "GENERATED_REPORTS": {
      "provenance_required": true,
      "description": "Reports, context-buffer files, handoff docs, and any agent-generated markdown.",
      "scope_patterns": [
        "context-buffer/*.md",
        "agent-logs/*.md",
        "reports/**/*.md",
        "lanes/**/outbox/*.md",
        "lanes/**/state/*.md"
      ]
    }
  },
  "violation_status": "FORMAT_VIOLATION"
}

