{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Archivist Agent",
  "version": "0.1.0",
  "identifier": "com.archivist.agent",
  "build": {
    "beforeDevCommand": "npx serve -p 1420 S:/Archivist-Agent/ui",
    "beforeBuildCommand": "",
    "frontendDist": "../ui",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Archivist Agent",
        "width": 1920,
        "height": 1080,
        "resizable": true,
        "fullscreen": false,
        "maximized": false,
        "minWidth": 1280,
        "minHeight": 720,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; worker-src 'self' blob:; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
